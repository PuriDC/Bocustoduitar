PORT=4000

# MySQL — the same server the Bocusto Luthier site uses, but its own database.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bocusto_guitars

# Admin logins fall back to this database's `users` table when the account is
# not found locally, so one Bocusto Luthier admin account opens both panels.
# Leave blank to keep the two sites' accounts completely separate.
SHARED_USERS_DB=bocusto_luthier

# Required — the server refuses to start without it. Anyone holding this value
# can forge an administrator token, so use a long random string and never
# commit the real one. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Must MATCH the Bocusto Luthier backend's JWT_SECRET for a single sign-in to
# work across both admin panels.
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h
