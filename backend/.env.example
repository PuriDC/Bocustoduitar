PORT=4000
# Interface to bind. Keep 127.0.0.1 behind nginx: 0.0.0.0 publishes the API,
# including the plaintext login endpoint, on the server's public address.
HOST=127.0.0.1

# MySQL — the same server the Bocusto Luthier site uses, but its own database.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bocusto_guitars

# Admin logins fall back to this database's `users` table when the account is
# not found locally, so one Bocusto Luthier admin account opens both panels.
# Leave blank to keep the two sites' accounts completely separate.
#
# NOTE: on the production VPS the Luthier database is called `bocustotonewood`,
# not `bocusto_luthier`. bootstrap-vps.sh reads the real name from the Luthier
# backend's own .env rather than guessing.
SHARED_USERS_DB=bocustotonewood

# Where uploaded images are written. nginx serves this directory at /uploads/,
# and deploy.sh excludes it from rsync so a deploy cannot wipe it.
UPLOAD_DIR=

# Cross-origin callers, comma separated. The site is served from the same
# origin as the API, so this stays empty in normal operation; anything listed
# here may call the API from another domain.
ALLOWED_ORIGINS=

# Required — the server refuses to start without it. Anyone holding this value
# can forge an administrator token, so use a long random string and never
# commit the real one. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Must MATCH the Bocusto Luthier backend's JWT_SECRET for a single sign-in to
# work across both admin panels.
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h
